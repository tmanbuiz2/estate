{
  "name": "estate-canada",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "predeploy:check": "npm run build",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler/deploy-check",
    "mobile": "npm --prefix mobile start"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
